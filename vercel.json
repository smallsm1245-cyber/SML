{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!js/|css/|assets/|api/|admin/|.*\\.html$|.*\\.js$|.*\\.css$|.*\\.xml$|.*\\.json$|.*\\.webp$|.*\\.png$|.*\\.jpg$|.*\\.ico$|.*\\.ttf$|.*\\.woff$|.*\\.woff2$|.*\\.svg$|.*\\.txt$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}